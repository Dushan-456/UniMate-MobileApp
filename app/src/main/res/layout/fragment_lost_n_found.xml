<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.lostnfound.LostNFoundFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TabLayout  -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/lostnfound_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
          />

        <!-- LOST ITEMS layout -->
        <LinearLayout
            android:id="@+id/lost_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/add_lost_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_background"
                android:text="Add New Lost Item" />

            <TextView
                android:id="@+id/lost_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No lost items reported yet."
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:textSize="16sp"
                android:textColor="#999999"
                android:visibility="gone" />

            <ListView
                android:id="@+id/lost_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- FOUND ITEMS layout -->
        <LinearLayout
            android:id="@+id/found_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/add_found_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_background"
                android:text="Add New Found Item" />

            <TextView
                android:id="@+id/found_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No found items reported yet."
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:textSize="16sp"
                android:textColor="#999999"
                android:visibility="gone" />

            <ListView
                android:id="@+id/found_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
